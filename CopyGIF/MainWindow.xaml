<Window x:Class="CopyGIF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CopyGIF.Converters"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        Title="CopyGIF"
        Icon="pack://application:,,,/Assets/Branding/CopyGIF.ico"
        Width="760"
        Height="560"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#202225"
        Deactivated="Window_Deactivated"
        PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:PreviewImageConverter
            x:Key="PreviewImageConverter"/>

        <Style x:Key="StandardButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Padding"
                    Value="12,5"/>
            <Setter Property="Background"
                    Value="#4F545C"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>

        <Style x:Key="NavigationButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="MinWidth"
                    Value="92"/>
            <Setter Property="Margin"
                    Value="0,0,8,0"/>
            <Setter Property="Padding"
                    Value="14,5"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#B9BBBE"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#36393F"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#5865F2"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Padding"
                    Value="10,3"/>
            <Setter Property="Margin"
                    Value="6,0,0,0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#B9BBBE"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="#4F545C"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HeaderButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#ED4245"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GifTileStyle"
               TargetType="ListBoxItem">
            <Setter Property="Height"
                    Value="160"/>
            <Setter Property="Margin"
                    Value="4"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <EventSetter
                Event="PreviewMouseLeftButtonUp"
                Handler="GifTile_PreviewMouseLeftButtonUp"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TileBorder"
                                Background="#2F3136"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="7"
                                ClipToBounds="True">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TileBorder"
                                        Property="BorderBrush"
                                        Value="#5865F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="34"/>
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Margin"
                    Value="0,7,7,0"/>
            <Setter Property="HorizontalAlignment"
                    Value="Right"/>
            <Setter Property="VerticalAlignment"
                    Value="Top"/>
            <Setter Property="Background"
                    Value="#D9111214"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="20"/>
            <Setter Property="Content"
                    Value="☆"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="ToolTip"
                    Value="Add to favorites"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}"
                             Value="True">
                    <Setter Property="Content"
                            Value="★"/>
                    <Setter Property="Foreground"
                            Value="#FEE75C"/>
                    <Setter Property="ToolTip"
                            Value="Remove from favorites"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#202225"
            BorderBrush="#3F4147"
            BorderThickness="1"
            SnapsToDevicePixels="True">

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        ToolTip="Drag to move CopyGIF">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="CopyGIF"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="HotkeyHintTextBlock"
                                   Margin="12,0,0,0"
                                   Foreground="#72767D"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            ToolTip="Open settings"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="SettingsButton_Click"/>

                    <Button Content="Exit"
                            ToolTip="Exit CopyGIF"
                            Style="{StaticResource ExitButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ToggleButton
                        x:Name="SearchTabButton"
                        IsChecked="True"
                        Content="Search"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="SearchTabButton_Click"/>

                    <ToggleButton
                        x:Name="FavoritesTabButton"
                        Content="Favorites"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="FavoritesTabButton_Click"/>

                    <ToggleButton
                        x:Name="RecentsTabButton"
                        Content="Recents"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="RecentsTabButton_Click"/>
                </StackPanel>

                <Button x:Name="ClearRecentsButton"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Content="Clear recents"
                        Style="{StaticResource StandardButtonStyle}"
                        Click="ClearRecentsButton_Click"/>
            </Grid>

            <Grid x:Name="SearchPanel"
                  Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Height="38"
                         Padding="10,7"
                         FontSize="16"
                         Background="#2F3136"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#4F545C"
                         TextChanged="SearchTextBox_TextChanged"
                         KeyDown="SearchTextBox_KeyDown"/>

                <Button x:Name="SearchButton"
                        Grid.Column="2"
                        Width="90"
                        Height="38"
                        Content="Search"
                        Background="#5865F2"
                        Style="{StaticResource StandardButtonStyle}"
                        Click="SearchButton_Click"/>
            </Grid>

            <Grid Grid.Row="6">
                <ListBox
                    x:Name="ResultsListBox"
                    Tag="3"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="White"
                    ItemContainerStyle="{StaticResource GifTileStyle}"
                    SizeChanged="ResultsListBox_SizeChanged"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid
                                Columns="{Binding Tag,
                                    RelativeSource={RelativeSource
                                    AncestorType={x:Type ListBox}}}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="#2F3136"
                                  MouseEnter="GifTile_MouseEnter"
                                  MouseLeave="GifTile_MouseLeave">
                                <Image
                                    Source="{Binding DisplayImageSource,
                                        Converter={StaticResource PreviewImageConverter}}"
                                    Stretch="UniformToFill"/>

                                <Image
                                    x:Name="AnimatedPreviewImage"
                                    gif:AnimationBehavior.SourceUri="{Binding AnimatedPreviewUri}"
                                    gif:AnimationBehavior.AutoStart="True"
                                    gif:AnimationBehavior.CacheFramesInMemory="False"
                                    gif:AnimationBehavior.RepeatBehavior="Forever"
                                    IsHitTestVisible="False"
                                    Stretch="UniformToFill"/>

                                <Button
                                    Tag="{Binding}"
                                    Style="{StaticResource FavoriteButtonStyle}"
                                    Click="FavoriteButton_Click"/>

                                <Border
                                    VerticalAlignment="Bottom"
                                    Padding="8,5"
                                    Background="#80111214">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        Foreground="#D9FFFFFF"
                                        FontWeight="Normal"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    x:Name="EmptyStateTextBlock"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#72767D"
                    FontSize="17"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    IsHitTestVisible="False"
                    Text="Type above to search for GIFs."/>

                <Border x:Name="BusyBorder"
                        Visibility="Collapsed"
                        Background="#AA202225">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <ProgressBar
                            Width="180"
                            Height="5"
                            IsIndeterminate="True"/>

                        <TextBlock
                            x:Name="BusyTextBlock"
                            Margin="0,10,0,0"
                            Foreground="White"
                            TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="7"
                  Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusTextBlock"
                    Foreground="#B9BBBE"
                    TextWrapping="Wrap"/>

                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Foreground="#72767D"
                    Text="Powered by KLIPY"/>
            </Grid>
        </Grid>
    </Border>
</Window>
