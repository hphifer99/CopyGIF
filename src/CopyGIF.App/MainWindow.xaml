<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="CopyGIF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CopyGIF.Core.Models"
    mc:Ignorable="d"
    Title="CopyGIF">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Padding="24,20,24,12">

            <StackPanel Spacing="3">

                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="CopyGIF" />

                <TextBlock
                    Opacity="0.65"
                    Text="Search for a GIF and copy it instantly." />

            </StackPanel>

        </Grid>

        <!-- Search -->
        <Grid
            Grid.Row="1"
            Padding="24,8,24,16"
            ColumnSpacing="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                MinWidth="240"
                PlaceholderText="Search GIFs"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.SearchCommand}"
                Content="Search" />

            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.CancelSearchCommand}"
                Content="Cancel" />

        </Grid>

        <!-- Results -->
        <Grid
            Grid.Row="2"
            Padding="16,0">

            <GridView
                ItemsSource="{x:Bind ViewModel.Results}">

                <GridView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:GifItem">

                        <Grid
                            Width="210"
                            Margin="4">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="140" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                CornerRadius="8">

                                <Image
                                    Stretch="UniformToFill">

                                    <Image.Source>
                                        <BitmapImage
                                            UriSource="{x:Bind ThumbnailUri}" />
                                    </Image.Source>

                                </Image>

                            </Border>

                            <TextBlock
                                Grid.Row="1"
                                Margin="4,6,4,2"
                                MaxLines="2"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                        </Grid>

                    </DataTemplate>

                </GridView.ItemTemplate>

                <GridView.ItemsPanel>

                    <ItemsPanelTemplate>

                        <ItemsWrapGrid
                            HorizontalAlignment="Center"
                            Orientation="Horizontal" />

                    </ItemsPanelTemplate>

                </GridView.ItemsPanel>

            </GridView>

        </Grid>

        <!-- Status -->
        <Border
            Grid.Row="3"
            Padding="24,12"
            BorderThickness="0,1,0,0">

            <Grid ColumnSpacing="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressRing
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Opacity="0.55">
                    <Run
                        Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" />
                    <Run Text=" results" />
                </TextBlock>

            </Grid>

        </Border>

    </Grid>

</Window>