<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CopyGIF.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="using:CopyGIF.App.Composition"
    xmlns:controls="using:CopyGIF.App.Controls">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/Colors.xaml" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/Themes.xaml" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/ControlStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <composition:BooleanNegationConverter
                x:Key="CopyGifBooleanNegationConverter" />

            <composition:UserMessageSeverityConverter
                x:Key="CopyGifMessageSeverityConverter" />

            <DataTemplate
                x:Key="CopyGifGifCardTemplate">

                <controls:GifCard
                    AnimatePreview="{Binding ReducedMotion, Converter={StaticResource CopyGifBooleanNegationConverter}}"
                    AutomationProperties.HelpText="Press Enter to copy this GIF. Use the Favorite button to change its saved state."
                    IsBusy="{Binding IsBusy}"
                    IsFavorite="{Binding IsFavorite}"
                    PreviewUri="{Binding CurrentSource}"
                    LoadThumbnailCommand="{Binding LoadThumbnailCommand}"
                    StartPreviewCommand="{Binding StartPreviewCommand}"
                    StopPreviewCommand="{Binding StopPreviewCommand}"
                    ProviderName="{Binding ProviderId}"
                    SelectCommand="{Binding CopyCommand}"
                    ThumbnailUri="{Binding ThumbnailSource}"
                    Title="{Binding Title}"
                    ToggleFavoriteCommand="{Binding ToggleFavoriteCommand}" />

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifOnboardingTemplate">

                <StackPanel Spacing="16">

                    <TextBlock
                        Style="{StaticResource CopyGifSectionTitleTextStyle}"
                        Text="{Binding ProviderDisplayName}" />

                    <TextBlock
                        Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                        Text="CopyGIF stores this credential using Windows-protected credential storage."
                        TextWrapping="Wrap" />

                    <PasswordBox
                        AutomationProperties.Name="GIF provider API key"
                        Header="API key"
                        Password="{Binding Credential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PasswordRevealMode="Peek"
                        PlaceholderText="Enter your API key" />

                    <HyperlinkButton
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Open API key help"
                        Command="{Binding OpenCredentialHelpCommand}"
                        Content="How do I get an API key?" />

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifGeneralSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Activation" />

                            <TextBox
                                AutomationProperties.Name="Global hotkey"
                                Header="Global hotkey"
                                PlaceholderText="Alt+G"
                                Text="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Start CopyGIF with Windows"
                                Header="Start with Windows"
                                IsOn="{Binding StartWithWindows, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Picker behavior" />

                            <ToggleSwitch
                                AutomationProperties.Name="Close picker when focus is lost"
                                Header="Close when focus is lost"
                                IsOn="{Binding CloseWhenFocusLost, Mode=TwoWay}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Hide picker after copying a GIF"
                                Header="Hide after copy"
                                IsOn="{Binding HideAfterCopy, Mode=TwoWay}" />

                            <ComboBox
                                AutomationProperties.Name="Window placement mode"
                                Header="Window placement"
                                ItemsSource="{Binding PlacementModes}"
                                SelectedItem="{Binding PlacementMode, Mode=TwoWay}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Remember picker window size"
                                Header="Remember window size"
                                IsOn="{Binding RememberWindowSize, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifSearchSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Results" />

                            <NumberBox
                                AutomationProperties.Name="Results per search"
                                Header="Results per search"
                                Maximum="{Binding MaximumResultsPerSearch}"
                                Minimum="{Binding MinimumResultsPerSearch}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ResultsPerSearch, Mode=TwoWay}" />

                            <NumberBox
                                AutomationProperties.Name="Search debounce milliseconds"
                                Header="Search delay in milliseconds"
                                Maximum="{Binding MaximumDebounceMilliseconds}"
                                Minimum="{Binding MinimumDebounceMilliseconds}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding DebounceMilliseconds, Mode=TwoWay}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Animate GIF previews"
                                Header="Animate previews"
                                IsOn="{Binding AnimatePreviews, Mode=TwoWay}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Automatically load more GIF results"
                                Header="Automatically load more results"
                                IsOn="{Binding AutoLoadMoreResults, Mode=TwoWay}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Show Trending GIFs when search is empty"
                                Header="Show Trending GIFs when search is empty"
                                IsOn="{Binding ShowTrendingWhenEmpty, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="History and suggestions" />

                            <ToggleSwitch
                                AutomationProperties.Name="Save search history"
                                Header="Save search history"
                                IsOn="{Binding SaveSearchHistory, Mode=TwoWay}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Use search history for suggestions"
                                Header="Use history for suggestions"
                                IsOn="{Binding UseHistorySuggestions, Mode=TwoWay}" />

                            <NumberBox
                                AutomationProperties.Name="Search history limit"
                                Header="Search history limit"
                                Maximum="{Binding MaximumSearchHistoryLimit}"
                                Minimum="{Binding MinimumSearchHistoryLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SearchHistoryLimit, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifAppearanceSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Theme" />

                            <ComboBox
                                AutomationProperties.Name="Application theme"
                                Header="Application theme"
                                ItemsSource="{Binding Themes}"
                                SelectedItem="{Binding Theme, Mode=TwoWay}" />

                            <TextBlock
                                Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                                Text="System follows your current Windows light or dark setting. High contrast always follows Windows."
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifLibrarySettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Saved GIF limits" />

                            <NumberBox
                                AutomationProperties.Name="Recent GIF limit"
                                Header="Recent GIF limit"
                                Maximum="{Binding MaximumRecentLimit}"
                                Minimum="{Binding MinimumRecentLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding RecentLimit, Mode=TwoWay}" />

                            <NumberBox
                                AutomationProperties.Name="Favorite GIF limit"
                                Header="Favorite GIF limit"
                                Maximum="{Binding MaximumFavoriteLimit}"
                                Minimum="{Binding MinimumFavoriteLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding FavoriteLimit, Mode=TwoWay}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Store Favorite GIFs locally"
                                Header="Store Favorites locally"
                                IsOn="{Binding StoreFavoritesLocally, Mode=TwoWay}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Store Recent GIFs locally"
                                Header="Store Recents locally"
                                IsOn="{Binding StoreRecentsLocally, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Storage location" />

                            <TextBlock
                                AutomationProperties.Name="Current library storage location"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding StorageLocationText}" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <Button
                                    AutomationProperties.Name="Choose library storage folder"
                                    Command="{Binding ChooseStorageRootCommand}"
                                    Content="Choose folder" />

                                <Button
                                    AutomationProperties.Name="Use default library storage folder"
                                    Command="{Binding ResetStorageRootCommand}"
                                    Content="Use default" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifApiSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="{Binding ProviderDisplayName}" />

                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding CredentialStatusText}" />

                            <PasswordBox
                                AutomationProperties.Name="GIF provider API key"
                                Header="API key"
                                Password="{Binding Credential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PasswordRevealMode="Peek"
                                PlaceholderText="Enter a replacement API key" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <Button
                                    AutomationProperties.Name="Delete saved API key"
                                    Command="{Binding DeleteCommand}"
                                    Content="Delete saved key" />

                                <HyperlinkButton
                                    AutomationProperties.Name="Open API key help"
                                    Command="{Binding OpenCredentialHelpCommand}"
                                    Content="API key help" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifUpdatesSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Update preferences" />

                            <ToggleSwitch
                                AutomationProperties.Name="Check for CopyGIF updates"
                                Header="Check for updates"
                                IsOn="{Binding Settings.CheckForUpdates, Mode=TwoWay}" />

                            <ComboBox
                                AutomationProperties.Name="Update check frequency"
                                Header="Check frequency"
                                ItemsSource="{Binding Settings.CheckFrequencies}"
                                SelectedItem="{Binding Settings.CheckFrequency, Mode=TwoWay}" />

                            <ComboBox
                                AutomationProperties.Name="Update installation mode"
                                Header="Update mode"
                                ItemsSource="{Binding Settings.Modes}"
                                SelectedItem="{Binding Settings.Mode, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Update status" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="Installed version:" />

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="{Binding Update.CurrentVersion}" />

                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="Available version:" />

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="{Binding Update.AvailableVersion}" />

                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding Update.Message.Text}" />

                            <ProgressBar
                                AutomationProperties.Name="Update download progress"
                                Maximum="100"
                                Value="{Binding Update.DownloadPercentage}" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <Button
                                    AutomationProperties.Name="Check for updates now"
                                    Command="{Binding Update.CheckCommand}"
                                    Content="Check now" />

                                <Button
                                    AutomationProperties.Name="Download and verify update"
                                    Command="{Binding Update.PrepareCommand}"
                                    Content="Download" />

                                <Button
                                    AutomationProperties.Name="Install verified update"
                                    Command="{Binding Update.InstallCommand}"
                                    Content="Install"
                                    Style="{StaticResource CopyGifPrimaryButtonStyle}" />

                            </StackPanel>

                            <HyperlinkButton
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Open update release notes"
                                Content="Release notes"
                                NavigateUri="{Binding Update.ReleaseNotesUri}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Settings.Message.Text}" />

                </StackPanel>

            </DataTemplate>

        </ResourceDictionary>

    </Application.Resources>

</Application>
