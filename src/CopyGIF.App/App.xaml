<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CopyGIF.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="using:CopyGIF.App.Composition"
    xmlns:services="using:CopyGIF.App.Services"
    xmlns:controls="using:CopyGIF.App.Controls">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/Colors.xaml" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/Themes.xaml" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/ControlStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <composition:BooleanNegationConverter
                x:Key="CopyGifBooleanNegationConverter" />

            <composition:UserMessageSeverityConverter
                x:Key="CopyGifMessageSeverityConverter" />

            <services:SettingChoiceLabelConverter x:Key="SettingChoiceLabelConverter" />
            <services:BooleanVisibilityConverter x:Key="MsiVisibilityConverter" />
            <services:BooleanVisibilityConverter x:Key="CopyGifBooleanVisibilityConverter" />
            <DataTemplate x:Key="SettingChoiceTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingChoiceLabelConverter}}" TextWrapping="Wrap" />
            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifGifCardTemplate">

                <controls:GifCard
                    AnimatePreview="{Binding ReducedMotion, Converter={StaticResource CopyGifBooleanNegationConverter}}"
                    AutomationProperties.HelpText="Press Enter to copy this GIF. Use the Favorite button to change its saved state."
                    IsBusy="{Binding IsBusy}"
                    IsFavorite="{Binding IsFavorite}"
                    DecodePixelSize="{Binding DecodePixelSize}"
                    DecodeByHeight="{Binding DecodeByHeight}"
                    PreviewUri="{Binding CurrentSource}"
                    LoadThumbnailCommand="{Binding LoadThumbnailCommand}"
                    StartPreviewCommand="{Binding StartPreviewCommand}"
                    StopPreviewCommand="{Binding StopPreviewCommand}"
                    ProviderName="{Binding ProviderId}"
                    SelectCommand="{Binding CopyCommand}"
                    ThumbnailUri="{Binding ThumbnailSource}"
                    Title="{Binding Title}"
                    ToggleFavoriteCommand="{Binding ToggleFavoriteCommand}" />

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifOnboardingTemplate">

                <StackPanel Spacing="16">

                    <ComboBox Header="GIF provider" ItemsSource="{Binding Providers}"
                        DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}" />
                    <TextBlock Text="Choose the provider for GIF search. Finish validates its key and saves this selection." TextWrapping="Wrap" />

                    <TextBlock
                        Style="{StaticResource CopyGifSectionTitleTextStyle}"
                        Text="{Binding ProviderDisplayName}" />

                    <TextBlock
                        Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                        Text="Create an API key for the selected provider, then paste it below. Finish encrypts the key on this PC."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                        Text="{Binding CredentialInstructions}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasCredentialInstructions, Converter={StaticResource CopyGifBooleanVisibilityConverter}}" />

                    <PasswordBox
                        AutomationProperties.Name="GIF provider API key"
                        Header="API key"
                        Password="{Binding Credential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PasswordRevealMode="Peek"
                        PlaceholderText="Enter your API key" />

                    <HyperlinkButton
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Open API key help"
                        Command="{Binding OpenCredentialHelpCommand}"
                        Content="Open provider API keys" />

                    <TextBlock
                        AutomationProperties.Name="Start with Windows notice"
                        Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                        Text="By default, CopyGIF starts with Windows and waits in the system tray so your hotkey is ready after sign-in. You can turn this off any time in CopyGIF Settings under General, or in Windows Settings under Apps, Startup."
                        TextWrapping="Wrap" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifGeneralSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Activation" />

                            <controls:HotkeyRecorder
                                AutomationProperties.Name="Global hotkey"
                                Text="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <controls:HotkeyRecorder.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Global hotkey" /><controls:InfoButton Subject="Global hotkey" Text="Press the shortcut you want to use. Escape cancels recording. Backspace or Delete clears it. An unavailable shortcut is reported when you apply settings." /></StackPanel></controls:HotkeyRecorder.Header>
                            </controls:HotkeyRecorder>

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Start with Windows" /><controls:InfoButton Subject="Start with Windows" Text="Starts CopyGIF in the tray at sign-in. Windows Startup apps can also disable it." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Start CopyGIF with Windows"
                                IsOn="{Binding StartWithWindows, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Window behavior" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Hide when CopyGIF loses focus" /><controls:InfoButton Subject="Hide when CopyGIF loses focus" Text="Hides the app when another app gets focus. Your Settings draft is kept." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Hide when CopyGIF loses focus"
                                IsOn="{Binding CloseWhenFocusLost, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Hide after copy" /><controls:InfoButton Subject="Hide after copy" Text="Hides the app after a successful clipboard copy." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Hide CopyGIF after copying a GIF"
                                IsOn="{Binding HideAfterCopy, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Close to system tray" /><controls:InfoButton Subject="Close to system tray" Text="Closing the app keeps CopyGIF in the tray. Tray Exit quits the app." /></StackPanel>
                            <ToggleSwitch AutomationProperties.Name="Close to system tray" IsOn="{Binding CloseToTray, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Center window when opened from tray" /><controls:InfoButton Subject="Center window when opened from tray" Text="Tray Open centers the app on that screen." /></StackPanel>
                            <ToggleSwitch AutomationProperties.Name="Center window when opened from tray" IsOn="{Binding CenterOnTrayOpen, Mode=TwoWay}" />

                            <ComboBox
                                AutomationProperties.Name="Window placement mode"

                                ItemsSource="{Binding PlacementModes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding PlacementMode, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Window placement" /><controls:InfoButton Subject="Window placement" Text="Choose near the pointer, screen center, or the last position." /></StackPanel></ComboBox.Header>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Remember window size" /><controls:InfoButton Subject="Remember window size" Text="Restores the last app width and height." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Remember window size"
                                IsOn="{Binding RememberWindowSize, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifSearchSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Results" />

                            <ComboBox AutomationProperties.Name="GIPHY content filter"
                                ItemsSource="{Binding ContentRatings}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding ContentRating, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Content filter" /><controls:InfoButton Subject="Content filter" Text="GIPHY uses this rating for search and trending. KLIPY uses the rating set for its API key. The default is PG." /></StackPanel></ComboBox.Header>
                            </ComboBox>

                            <NumberBox
                                AutomationProperties.Name="Results per search"

                                Maximum="{Binding MaximumResultsPerSearch}"
                                Minimum="{Binding MinimumResultsPerSearch}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ResultsPerSearch, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Results per search" /><controls:InfoButton Subject="Results per search" Text="GIFs requested per page. GIPHY allows up to 50." /></StackPanel></NumberBox.Header>
                            </NumberBox>

                            <NumberBox
                                AutomationProperties.Name="Search debounce milliseconds"

                                Maximum="{Binding MaximumDebounceMilliseconds}"
                                Minimum="{Binding MinimumDebounceMilliseconds}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding DebounceMilliseconds, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Search delay after typing (ms)" /><controls:InfoButton Subject="Search delay after typing (ms)" Text="Waits after typing stops. Enter starts immediately." /></StackPanel></NumberBox.Header>
                            </NumberBox>

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Animate previews" /><controls:InfoButton Subject="Animate previews" Text="GIFs animate on hover when Windows permits animation." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Animate GIF previews"
                                IsOn="{Binding AnimatePreviews, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Automatically load more results" /><controls:InfoButton Subject="Automatically load more results" Text="Scrolling to the bottom can request another page." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Automatically load more GIF results"
                                IsOn="{Binding AutoLoadMoreResults, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Show Trending GIFs when search is empty" /><controls:InfoButton Subject="Show Trending GIFs when search is empty" Text="Shows trending GIFs when you clear the search." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Show Trending GIFs when search is empty"
                                IsOn="{Binding ShowTrendingWhenEmpty, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="History and suggestions" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Save search history" /><controls:InfoButton Subject="Save search history" Text="Remembers submitted terms on this PC. Disabling it keeps existing terms." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Save search history"
                                IsOn="{Binding SaveSearchHistory, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Use history for suggestions" /><controls:InfoButton Subject="Use history for suggestions" Text="Offers matching saved terms as you type." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Use search history for suggestions"
                                IsOn="{Binding UseHistorySuggestions, Mode=TwoWay}" />

                            <NumberBox
                                AutomationProperties.Name="Search history limit"

                                Maximum="{Binding MaximumSearchHistoryLimit}"
                                Minimum="{Binding MinimumSearchHistoryLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SearchHistoryLimit, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Search history limit" /><controls:InfoButton Subject="Search history limit" Text="Maximum number of saved search terms." /></StackPanel></NumberBox.Header>
                            </NumberBox>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifAppearanceSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Theme" />

                            <ComboBox
                                AutomationProperties.Name="Application theme"

                                ItemsSource="{Binding Themes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Theme, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Application theme" /><controls:InfoButton Subject="Application theme" Text="Choose Windows, light, or dark." /></StackPanel></ComboBox.Header>
                            </ComboBox>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource CopyGifSettingsSectionBorderStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource CopyGifSectionTitleTextStyle}" Text="Quality" />
                            <ComboBox AutomationProperties.Name="Copy quality"
                                ItemsSource="{Binding GifQualities}" ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding CopyQuality, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Copy quality" /><controls:InfoButton Subject="Copy quality" Text="Chooses which GIF the provider supplies for copying to other apps. Minimum is the smallest file and Maximum is the original. The nearest available size is used when a provider omits one." /></StackPanel></ComboBox.Header>
                            </ComboBox>
                            <ComboBox AutomationProperties.Name="Save quality"
                                ItemsSource="{Binding GifQualities}" ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding SaveQuality, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Save quality" /><controls:InfoButton Subject="Save quality" Text="Chooses which GIF is stored in Favorites and Recents. It applies only to files saved from now on, so files already saved keep the quality they were saved at." /></StackPanel></ComboBox.Header>
                            </ComboBox>
                            <ComboBox AutomationProperties.Name="Display quality"
                                ItemsSource="{Binding GifQualities}" ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding DisplayQuality, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Display quality" /><controls:InfoButton Subject="Display quality" Text="Sets how large each thumbnail is decoded inside CopyGIF, from 128 pixels at Minimum to 512 at Maximum. It changes image memory only. What is copied and what is saved are unaffected." /></StackPanel></ComboBox.Header>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifLibrarySettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Saved GIF limits" />

                            <NumberBox
                                AutomationProperties.Name="Recent GIF limit"

                                Maximum="{Binding MaximumRecentLimit}"
                                Minimum="{Binding MinimumRecentLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding RecentLimit, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Recent GIF limit" /><controls:InfoButton Subject="Recent GIF limit" Text="A new copy removes the oldest Recent when the limit is reached." /></StackPanel></NumberBox.Header>
                            </NumberBox>

                            <NumberBox
                                AutomationProperties.Name="Favorite GIF limit"

                                Maximum="{Binding MaximumFavoriteLimit}"
                                Minimum="{Binding MinimumFavoriteLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding FavoriteLimit, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Favorite GIF limit" /><controls:InfoButton Subject="Favorite GIF limit" Text="Maximum Favorites. Lowering it keeps existing entries." /></StackPanel></NumberBox.Header>
                            </NumberBox>

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Store Favorites locally" /><controls:InfoButton Subject="Store Favorites locally" Text="Saves new Favorites as files for either provider." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Store Favorite GIFs locally"
                                IsOn="{Binding StoreFavoritesLocally, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Store Recents locally" /><controls:InfoButton Subject="Store Recents locally" Text="Saves new Recents as files. Clipboard files are separate." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Store Recent GIFs locally"
                                IsOn="{Binding StoreRecentsLocally, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="12">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                    Text="Storage location" />
                                <controls:InfoButton Subject="Storage location" Text="Moves saved library files to the selected folder." />
                            </StackPanel>

                            <TextBlock
                                AutomationProperties.Name="Current library storage location"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding StorageLocationText}" />

                            <StackPanel
                                Orientation="Vertical"
                                Spacing="8">

                                <Button
                                    AutomationProperties.Name="Choose library storage folder"
                                    Command="{Binding ChooseStorageRootCommand}"
                                    Content="Choose folder" />

                                <Button
                                    AutomationProperties.Name="Use default library storage folder"
                                    Command="{Binding ResetStorageRootCommand}"
                                    Content="Use default" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="12">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                    Text="Logs and staged files" />
                                <controls:InfoButton Subject="Logs and staged files" Text="These are the folders this build is really using. A packaged build stores them inside its own package folder, not where the plain AppData path would suggest." />
                            </StackPanel>

                            <TextBlock
                                AutomationProperties.Name="Current log folder"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding LogsLocationText}" />

                            <TextBlock
                                AutomationProperties.Name="Current clipboard staging folder"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding ClipboardLocationText}" />

                            <StackPanel
                                Orientation="Vertical"
                                Spacing="8">

                                <Button
                                    AutomationProperties.Name="Open log folder"
                                    Command="{Binding OpenLogsFolderCommand}"
                                    Content="Open logs folder" />

                                <Button
                                    AutomationProperties.Name="Open clipboard staging folder"
                                    Command="{Binding OpenClipboardFolderCommand}"
                                    Content="Open clipboard folder" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <!-- One API key section. The Settings page repeats this for every registered provider. -->
            <DataTemplate x:Key="CopyGifProviderKeyTemplate">
                <Border Style="{StaticResource CopyGifSettingsSectionBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CopyGifSectionTitleTextStyle}" />
                        <PasswordBox Header="{Binding KeyHeader}" Password="{Binding Credential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PasswordRevealMode="Peek" PlaceholderText="{Binding Placeholder}" />
                        <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap"
                            Visibility="{Binding HasInstructions, Converter={StaticResource CopyGifBooleanVisibilityConverter}}" />
                        <TextBlock Text="A replacement key is checked when you apply changes." TextWrapping="Wrap" />
                        <CheckBox Content="{Binding RemoveLabel}" IsChecked="{Binding DeleteKey, Mode=TwoWay}" />
                        <HyperlinkButton Content="{Binding HelpLabel}" NavigateUri="{Binding HelpUri}"
                            Visibility="{Binding HasHelpUri, Converter={StaticResource CopyGifBooleanVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CopyGifApiSettingsTemplate">
                <StackPanel Spacing="16">
                    <ComboBox ItemsSource="{Binding Providers}"
                        DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ActiveProviderId, Mode=TwoWay}">
                        <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="GIF provider" /><controls:InfoButton Subject="GIF provider" Text="Choose a provider for future searches. Each provider has a separate protected API key." /></StackPanel></ComboBox.Header>
                    </ComboBox>
                    <ItemsControl ItemsSource="{Binding Keys}" ItemTemplate="{StaticResource CopyGifProviderKeyTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifUpdatesSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Visibility="{Binding Update.IsMsiInstallation, Converter={StaticResource MsiVisibilityConverter}}"
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Update preferences" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Check automatically for updates" /><controls:InfoButton Subject="Check automatically for updates" Text="Checks while CopyGIF runs. Check now is always available." /></StackPanel>
                            <ToggleSwitch
                                AutomationProperties.Name="Check for CopyGIF updates"
                                IsOn="{Binding Settings.CheckForUpdates, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Check frequency" /><controls:InfoButton Subject="Check frequency" Text="How often an automatic check becomes due." /></StackPanel>
                            <ComboBox
                                AutomationProperties.Name="Update check frequency"

                                IsEnabled="{Binding Settings.CheckForUpdates}"
                                ItemsSource="{Binding Settings.CheckFrequencies}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Settings.CheckFrequency, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Update mode" /><controls:InfoButton Subject="Update mode" Text="Choose notifications, download and prompt, or automatic install for supported MSI installations." /></StackPanel>
                            <ComboBox
                                AutomationProperties.Name="Update installation mode"

                                IsEnabled="{Binding Settings.CheckForUpdates}"
                                ItemsSource="{Binding Settings.Modes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Settings.Mode, Mode=TwoWay}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Update status" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="Installed version:" />

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="{Binding Update.CurrentVersion}" />

                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="Available version:" />

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="{Binding Update.AvailableVersion}" />

                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding Update.Message.Text}" />

                            <ProgressBar
                                Visibility="{Binding Update.IsMsiInstallation, Converter={StaticResource MsiVisibilityConverter}}"
                                AutomationProperties.Name="Update download progress"
                                Maximum="100"
                                Value="{Binding Update.DownloadPercentage}" />

                            <StackPanel
                                Orientation="Vertical"
                                Spacing="8">

                                <Button
                                    AutomationProperties.Name="Check for updates now"
                                    Command="{Binding Update.CheckCommand}"
                                    Content="Check now" />

                                <Button
                                    AutomationProperties.Name="Download and verify update"
                                    Visibility="{Binding Update.IsMsiInstallation, Converter={StaticResource MsiVisibilityConverter}}"
                                    Command="{Binding Update.PrepareCommand}"
                                    Content="Download" />

                                <Button
                                    AutomationProperties.Name="Install verified update"
                                    Visibility="{Binding Update.IsMsiInstallation, Converter={StaticResource MsiVisibilityConverter}}"
                                    Command="{Binding Update.InstallCommand}"
                                    Content="Install"
                                    Style="{StaticResource CopyGifPrimaryButtonStyle}" />

                            </StackPanel>

                            <HyperlinkButton
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Open update release notes"
                                Content="Release notes"
                                NavigateUri="{Binding Update.ReleaseNotesUri}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Settings.Message.Text}" />

                </StackPanel>

            </DataTemplate>

        </ResourceDictionary>

    </Application.Resources>

</Application>
