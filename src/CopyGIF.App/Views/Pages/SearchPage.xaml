<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CopyGIF.App.Views.Pages.SearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CopyGIF.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="{StaticResource CopyGifPagePadding}"
        RowSpacing="16"
        Style="{StaticResource CopyGifPageRootStyle}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="{StaticResource CopyGifPageHeaderMargin}"
            Spacing="4">

            <TextBlock
                Style="{StaticResource CopyGifPageTitleTextStyle}"
                Text="Search" />

            <TextBlock
                Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                Text="Find a GIF, preview it, and copy it to the clipboard." />

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Spacing="12">

            <controls:SearchHeader
                x:Name="PageSearchHeader"
                CancelCommand="{Binding CancelCommand, ElementName=Root}"
                ClearCommand="{Binding ClearQueryCommand, ElementName=Root}"
                DebouncedSearchCommand="{Binding DebouncedSearchCommand, ElementName=Root}"
                IsBusy="{Binding IsBusy, ElementName=Root}"
                Query="{Binding Query, ElementName=Root, Mode=TwoWay}"
                RefreshSuggestionsCommand="{Binding RefreshSuggestionsCommand, ElementName=Root}"
                SearchCommand="{Binding SearchCommand, ElementName=Root}"
                Suggestions="{Binding Suggestions, ElementName=Root}" />

            <controls:StatusBanner
                x:Name="PageStatusBanner"
                IsClosable="False"
                Message="{Binding StatusMessage, ElementName=Root}"
                Severity="{Binding StatusSeverity, ElementName=Root}"
                Title="Search status" />

        </StackPanel>

        <Grid Grid.Row="2">

            <GridView
                x:Name="ResultsGridView"
                AutomationProperties.Name="GIF search results"
                IsItemClickEnabled="False"
                IsTabStop="False"
                ItemTemplate="{Binding ItemTemplate, ElementName=Root}"
                ItemsSource="{Binding ItemsSource, ElementName=Root}"
                SelectionMode="None">

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

            </GridView>

            <StackPanel
                x:Name="EmptyStatePanel"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Spacing="8">

                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource CopyGifSectionTitleTextStyle}"
                    Text="No GIFs to show" />

                <TextBlock
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                    Text="Enter a search above or choose one of the available suggestions." />

            </StackPanel>

        </Grid>

        <Grid
            Grid.Row="3"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="LoadingTextBlock"
                Grid.Column="0"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource CopyGifStatusTextStyle}"
                Text="Loading GIFs..." />

            <ProgressRing
                x:Name="LoadingProgressRing"
                Grid.Column="1"
                Width="24"
                Height="24"
                AutomationProperties.Name="Loading GIFs"
                IsActive="{Binding IsBusy, ElementName=Root}" />

            <Button
                x:Name="LoadMoreButton"
                Grid.Column="2"
                AutomationProperties.Name="Load more GIFs"
                Command="{Binding LoadMoreCommand, ElementName=Root}"
                Content="Load more" />

        </Grid>

    </Grid>

</Page>
