<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CopyGIF.App.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CopyGIF.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Welcome to CopyGIF">

    <Grid
        x:Name="WindowRoot"
        MinWidth="560"
        MinHeight="480"
        Padding="32"
        RowSpacing="20"
        Style="{StaticResource CopyGifPageRootStyle}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Style="{StaticResource CopyGifPageTitleTextStyle}"
                Text="{Binding StepTitle}" />

            <TextBlock
                Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                Text="{Binding StepDescription}" />

        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">

            <ContentPresenter
                x:Name="StepContentPresenter"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind StepContent, Mode=OneWay}"
                ContentTemplate="{x:Bind StepContentTemplate, Mode=OneWay}" />

        </ScrollViewer>

        <controls:StatusBanner
            x:Name="PageStatusBanner"
            Grid.Row="2"
            IsClosable="False"
            Message="{Binding StatusMessage}"
            Severity="{Binding StatusSeverity}"
            Title="Setup status" />

        <Grid Grid.Row="3">

            <Button
                x:Name="FinishButton"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Finish setup"
                Command="{Binding FinishCommand}"
                Content="Finish"
                Style="{StaticResource CopyGifPrimaryButtonStyle}" />

        </Grid>

    </Grid>

</Window>
