<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CopyGIF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CopyGIF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,20,24,16">

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="CopyGIF" />

                <TextBlock
                    Opacity="0.65"
                    Text="Fast GIF search and clipboard access" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="24">

            <StackPanel
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Application foundation" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Text="The WinUI 3 application and CopyGIF Core project are connected and running."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="HealthCheckButton"
                    HorizontalAlignment="Center"
                    Click="HealthCheckButton_Click"
                    Content="Verify application shell" />

                <TextBlock
                    x:Name="StatusText"
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    Text="Ready" />

            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="24,12"
            BorderThickness="0,1,0,0">

            <TextBlock
                FontSize="12"
                Opacity="0.55"
                Text="CopyGIF" />

        </Border>
    </Grid>
</Window>