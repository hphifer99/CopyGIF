<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CopyGIF.App.Controls.SearchHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Column="0"
            AutomationProperties.Name="Search GIFs"
            ItemsSource="{Binding Suggestions, ElementName=Root}"
            PlaceholderText="{Binding PlaceholderText, ElementName=Root}"
            QuerySubmitted="SearchBox_QuerySubmitted"
            SuggestionChosen="SearchBox_SuggestionChosen"
            Text="{Binding Query, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="SearchBox_TextChanged" />

        <Button
            x:Name="ClearButton"
            Grid.Column="1"
            AutomationProperties.Name="Clear search"
            Click="ClearButton_Click"
            Style="{StaticResource CopyGifIconButtonStyle}"
            ToolTipService.ToolTip="Clear search">

            <FontIcon Glyph="&#xE894;" />

        </Button>

        <Button
            Grid.Column="2"
            AutomationProperties.Name="Search"
            Command="{Binding SearchCommand, ElementName=Root}"
            Content="Search"
            Style="{StaticResource CopyGifPrimaryButtonStyle}" />

        <ProgressRing
            x:Name="SearchProgressRing"
            Grid.Column="3"
            Width="24"
            Height="24"
            AutomationProperties.Name="Search in progress"
            IsActive="{Binding IsBusy, ElementName=Root}" />

        <Button
            x:Name="CancelButton"
            Grid.Column="4"
            AutomationProperties.Name="Cancel search"
            Command="{Binding CancelCommand, ElementName=Root}"
            Content="Cancel" />

    </Grid>

</UserControl>
