<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="CopyGIF.App.StartupFailureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CopyGIF startup problem">

    <Grid
        Padding="32"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <StackPanel
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <FontIcon
                HorizontalAlignment="Left"
                FontSize="36"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="&#xE7BA;" />

            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="CopyGIF could not start safely" />

            <TextBlock
                x:Name="MessageTextBlock"
                FontSize="15"
                TextWrapping="Wrap" />

            <TextBlock
                Opacity="0.7"
                Text="Your existing CopyGIF settings and library were not intentionally deleted. Close the app, preserve the CopyGIF data folder, and review the migration error before trying again."
                TextWrapping="Wrap" />

            <Button
                HorizontalAlignment="Left"
                Click="CloseButton_Click"
                Content="Close CopyGIF" />

        </StackPanel>

    </Grid>

</Window>
