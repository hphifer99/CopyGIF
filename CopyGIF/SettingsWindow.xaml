<Window x:Class="CopyGIF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CopyGIF Settings"
        Icon="pack://application:,,,/Assets/Branding/CopyGIF.ico"
        Width="650"
        Height="730"
        MinWidth="560"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#202225"
        Foreground="White"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#2F3136"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#4F545C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#2F3136"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#4F545C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#2F3136"/>
            <Setter Property="Foreground" Value="#DCDDDE"/>
            <Setter Property="BorderBrush" Value="#4F545C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2"
                                                SnapsToDevicePixels="True">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="1"
                                                        Background="#36393F"
                                                        BorderBrush="#4F545C"
                                                        BorderThickness="1,0,0,0"/>

                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="#DCDDDE"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="ToggleBorder"
                                                        Property="BorderBrush"
                                                        Value="#72767D"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="ToggleBorder"
                                                        Property="BorderBrush"
                                                        Value="#5865F2"/>
                                            </Trigger>

                                            <Trigger Property="IsEnabled"
                                                     Value="False">
                                                <Setter TargetName="ToggleBorder"
                                                        Property="Opacity"
                                                        Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="10,0,40,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              SnapsToDevicePixels="True"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">

                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">

                                    <Border Background="#2F3136"
                                            BorderBrush="#4F545C"
                                            BorderThickness="1"
                                            CornerRadius="2"/>

                                    <ScrollViewer Margin="1"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Background" Value="#2F3136"/>
            <Setter Property="Foreground" Value="#DCDDDE"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#4F545C"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#5865F2"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="#72767D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCDDDE"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="#4F545C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCDDDE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HelpStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A3A6AA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="SettingsTitleTextBlock"
                       Text="Settings"
                       FontSize="22"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="API access"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="API key"
                           Style="{StaticResource LabelStyle}"/>

                <Grid>
                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                 PasswordChanged="ApiKeyPasswordBox_PasswordChanged"/>

                    <TextBox x:Name="ApiKeyTextBox"
                             Visibility="Collapsed"
                             TextChanged="ApiKeyTextBox_TextChanged"/>
                </Grid>

                <CheckBox x:Name="ShowApiKeyCheckBox"
                          Margin="0,7,0,0"
                          Content="Show API key"
                          Checked="ShowApiKeyCheckBox_Changed"
                          Unchecked="ShowApiKeyCheckBox_Changed"/>

                <TextBlock Text="Required to search KLIPY. Your key is stored securely on this device."
                           Style="{StaticResource HelpStyle}"/>

                <TextBlock Margin="0,5,0,0"
                           Foreground="#8EA1E1"
                           FontSize="11">
                    <Hyperlink NavigateUri="https://klipy.com/developers"
                               RequestNavigate="KlipyDevelopersLink_RequestNavigate">
                        Get a KLIPY API key
                    </Hyperlink>
                </TextBlock>

                <Separator Margin="0,16"
                           Background="#4F545C"/>

                <TextBlock Text="Search and shortcuts"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Keyboard shortcut"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="HotkeyTextBox"/>

                        <TextBlock Text="Examples: Alt+G or Ctrl+Shift+G"
                                   Style="{StaticResource HelpStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Results per search"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="ResultsPerSearchTextBox"/>

                        <TextBlock Text="Allowed range: 6 to 50"
                                   Style="{StaticResource HelpStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Search delay"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="SearchDelayTextBox"/>

                        <TextBlock Text="Wait time after typing: 150 to 2,000 ms"
                                   Style="{StaticResource HelpStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Open location"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox x:Name="WindowPlacementComboBox">
                            <ComboBoxItem Content="Near the pointer"
                                          Tag="Mouse"/>

                            <ComboBoxItem Content="Last used position"
                                          Tag="Remember"/>

                            <ComboBoxItem Content="Center of current screen"
                                          Tag="Center"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                
                <CheckBox x:Name="AnimatePreviewsCheckBox"
                          Margin="0,14,0,0"
                          Content="Animate GIF previews"/>
                
                <Separator Margin="0,16"
                           Background="#4F545C"/>

                <TextBlock Text="Application"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <CheckBox x:Name="CloseWhenFocusLostCheckBox"
                          Margin="0,0,0,9"
                          Content="Hide CopyGIF when switching to another app"/>

                <CheckBox x:Name="HideAfterCopyCheckBox"
                          Margin="0,0,0,9"
                          Content="Hide CopyGIF after copying a GIF"/>

                <CheckBox x:Name="RememberWindowSizeCheckBox"
                          Margin="0,0,0,9"
                          Content="Remember window size"/>

                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start CopyGIF with Windows"/>

                <Separator Margin="0,16"
                           Background="#4F545C"/>

                <TextBlock Text="Library"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Maximum favorites"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="FavoriteLimitTextBox"/>

                        <TextBlock Text="Allowed range: 1 to 500"
                                   Style="{StaticResource HelpStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Recent history limit"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="RecentLimitTextBox"/>

                        <TextBlock Text="Allowed range: 1 to 100"
                                   Style="{StaticResource HelpStyle}"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="StoreFavoritesLocallyCheckBox"
                          Margin="0,14,0,9"
                          Content="Save favorite GIFs on this device"/>

                <CheckBox x:Name="StoreRecentsLocallyCheckBox"
                          Content="Save recent GIFs on this device"/>

                <TextBlock Margin="0,6,0,0"
                           Text="Saved GIFs load faster and use less data."
                           Style="{StaticResource HelpStyle}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="SettingsStatusTextBlock"
                           Foreground="#FAA61A"
                           TextWrapping="Wrap"/>

                <Button x:Name="RestoreDefaultsButton"
                        Margin="0,6,0,0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#8EA1E1"
                        Cursor="Hand"
                        Content="Restore defaults"
                        Click="RestoreDefaultsButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button x:Name="CancelButton"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Cancel"
                        IsCancel="True"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Save"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
