<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CopyGIF.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="using:CopyGIF.App.Composition"
    xmlns:services="using:CopyGIF.App.Services"
    xmlns:controls="using:CopyGIF.App.Controls">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/Colors.xaml" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/Themes.xaml" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/ControlStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <composition:BooleanNegationConverter
                x:Key="CopyGifBooleanNegationConverter" />

            <composition:UserMessageSeverityConverter
                x:Key="CopyGifMessageSeverityConverter" />

            <services:SettingChoiceLabelConverter x:Key="SettingChoiceLabelConverter" />
            <services:BooleanVisibilityConverter x:Key="MsiVisibilityConverter" />
            <DataTemplate x:Key="SettingChoiceTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingChoiceLabelConverter}}" TextWrapping="Wrap" />
            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifGifCardTemplate">

                <controls:GifCard
                    AnimatePreview="{Binding ReducedMotion, Converter={StaticResource CopyGifBooleanNegationConverter}}"
                    AutomationProperties.HelpText="Press Enter to copy this GIF. Use the Favorite button to change its saved state."
                    IsBusy="{Binding IsBusy}"
                    IsFavorite="{Binding IsFavorite}"
                    DecodePixelSize="{Binding DecodePixelSize}"
                    DecodeByHeight="{Binding DecodeByHeight}"
                    PreviewUri="{Binding CurrentSource}"
                    LoadThumbnailCommand="{Binding LoadThumbnailCommand}"
                    StartPreviewCommand="{Binding StartPreviewCommand}"
                    StopPreviewCommand="{Binding StopPreviewCommand}"
                    ProviderName="{Binding ProviderId}"
                    SelectCommand="{Binding CopyCommand}"
                    ThumbnailUri="{Binding ThumbnailSource}"
                    Title="{Binding Title}"
                    ToggleFavoriteCommand="{Binding ToggleFavoriteCommand}" />

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifOnboardingTemplate">

                <StackPanel Spacing="16">

                    <ComboBox Header="GIF provider" ItemsSource="{Binding Providers}"
                        DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}" />
                    <TextBlock Text="Choose the provider for GIF search. Finish validates its key and saves this selection." TextWrapping="Wrap" />

                    <TextBlock
                        Style="{StaticResource CopyGifSectionTitleTextStyle}"
                        Text="{Binding ProviderDisplayName}" />

                    <TextBlock
                        Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                        Text="Create an API key for the selected provider, then paste it below. For GIPHY, choose API instead of SDK. Finish encrypts the key on this PC."
                        TextWrapping="Wrap" />

                    <PasswordBox
                        AutomationProperties.Name="GIF provider API key"
                        Header="API key"
                        Password="{Binding Credential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PasswordRevealMode="Peek"
                        PlaceholderText="Enter your API key" />

                    <HyperlinkButton
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Open API key help"
                        Command="{Binding OpenCredentialHelpCommand}"
                        Content="Open provider API keys" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifGeneralSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Activation" />

                            <TextBox
                                AutomationProperties.Name="Global hotkey"

                                PlaceholderText="Alt+G"
                                Text="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Global hotkey" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Global hotkey information" AutomationProperties.HelpText="Opens GIF search from any app. An unavailable shortcut is reported." ToolTipService.ToolTip="Opens GIF search from any app. An unavailable shortcut is reported." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></TextBox.Header>
                            </TextBox>

                            <ToggleSwitch
                                AutomationProperties.Name="Start CopyGIF with Windows"

                                IsOn="{Binding StartWithWindows, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Start with Windows" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Start with Windows information" AutomationProperties.HelpText="Starts CopyGIF in the tray at sign-in. Windows Startup apps can also disable it." ToolTipService.ToolTip="Starts CopyGIF in the tray at sign-in. Windows Startup apps can also disable it." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Window behavior" />

                            <ToggleSwitch
                                AutomationProperties.Name="Hide when CopyGIF loses focus"

                                IsOn="{Binding CloseWhenFocusLost, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Hide when CopyGIF loses focus" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Hide when CopyGIF loses focus information" AutomationProperties.HelpText="Hides the picker when another app gets focus. Your Settings draft is kept." ToolTipService.ToolTip="Hides the picker when another app gets focus. Your Settings draft is kept." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <ToggleSwitch
                                AutomationProperties.Name="Hide CopyGIF after copying a GIF"

                                IsOn="{Binding HideAfterCopy, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Hide after copy" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Hide after copy information" AutomationProperties.HelpText="Hides the picker after a successful clipboard copy." ToolTipService.ToolTip="Hides the picker after a successful clipboard copy." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <ToggleSwitch
                                AutomationProperties.Name="Close to system tray" IsOn="{Binding CloseToTray, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Close to system tray" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Close to system tray information" AutomationProperties.HelpText="Closing the picker keeps CopyGIF in the tray. Tray Exit quits the app." ToolTipService.ToolTip="Closing the picker keeps CopyGIF in the tray. Tray Exit quits the app." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>
                            <ToggleSwitch
                                AutomationProperties.Name="Center window when opened from tray" IsOn="{Binding CenterOnTrayOpen, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Center window when opened from tray" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Center window when opened from tray information" AutomationProperties.HelpText="Tray Open centers the picker on that screen." ToolTipService.ToolTip="Tray Open centers the picker on that screen." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <ComboBox
                                AutomationProperties.Name="Window placement mode"

                                ItemsSource="{Binding PlacementModes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding PlacementMode, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Window placement" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Window placement information" AutomationProperties.HelpText="Choose near the pointer, screen center, or the last position." ToolTipService.ToolTip="Choose near the pointer, screen center, or the last position." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ComboBox.Header>
                            </ComboBox>

                            <ToggleSwitch
                                AutomationProperties.Name="Remember window size"

                                IsOn="{Binding RememberWindowSize, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Remember window size" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Remember window size information" AutomationProperties.HelpText="Restores the last picker width and height." ToolTipService.ToolTip="Restores the last picker width and height." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifSearchSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Results" />

                            <ComboBox AutomationProperties.Name="GIPHY content filter"
                                ItemsSource="{Binding ContentRatings}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding ContentRating, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Content filter" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Content filter information" AutomationProperties.HelpText="GIPHY uses this rating for search and trending. KLIPY uses the rating set for its API key. The default is All available." ToolTipService.ToolTip="GIPHY uses this rating for search and trending. KLIPY uses the rating set for its API key. The default is All available." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ComboBox.Header>
                            </ComboBox>

                            <NumberBox
                                AutomationProperties.Name="Results per search"

                                Maximum="{Binding MaximumResultsPerSearch}"
                                Minimum="{Binding MinimumResultsPerSearch}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ResultsPerSearch, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Results per search" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Results per search information" AutomationProperties.HelpText="GIFs requested per page. GIPHY allows up to 50." ToolTipService.ToolTip="GIFs requested per page. GIPHY allows up to 50." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></NumberBox.Header>
                            </NumberBox>

                            <NumberBox
                                AutomationProperties.Name="Search debounce milliseconds"

                                Maximum="{Binding MaximumDebounceMilliseconds}"
                                Minimum="{Binding MinimumDebounceMilliseconds}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding DebounceMilliseconds, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Search delay after typing (ms)" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Search delay after typing (ms) information" AutomationProperties.HelpText="Waits after typing stops. Enter starts immediately." ToolTipService.ToolTip="Waits after typing stops. Enter starts immediately." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></NumberBox.Header>
                            </NumberBox>

                            <ToggleSwitch
                                AutomationProperties.Name="Animate GIF previews"

                                IsOn="{Binding AnimatePreviews, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Animate previews" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Animate previews information" AutomationProperties.HelpText="GIFs animate on hover when Windows permits animation." ToolTipService.ToolTip="GIFs animate on hover when Windows permits animation." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <ToggleSwitch
                                AutomationProperties.Name="Automatically load more GIF results"

                                IsOn="{Binding AutoLoadMoreResults, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Automatically load more results" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Automatically load more results information" AutomationProperties.HelpText="Scrolling to the bottom can request another page." ToolTipService.ToolTip="Scrolling to the bottom can request another page." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <ToggleSwitch
                                AutomationProperties.Name="Show Trending GIFs when search is empty"

                                IsOn="{Binding ShowTrendingWhenEmpty, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Show Trending GIFs when search is empty" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Show Trending GIFs when search is empty information" AutomationProperties.HelpText="Shows trending GIFs when you clear the search." ToolTipService.ToolTip="Shows trending GIFs when you clear the search." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="History and suggestions" />

                            <ToggleSwitch
                                AutomationProperties.Name="Save search history"

                                IsOn="{Binding SaveSearchHistory, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Save search history" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Save search history information" AutomationProperties.HelpText="Remembers submitted terms on this PC. Disabling it keeps existing terms." ToolTipService.ToolTip="Remembers submitted terms on this PC. Disabling it keeps existing terms." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <ToggleSwitch
                                AutomationProperties.Name="Use search history for suggestions"

                                IsOn="{Binding UseHistorySuggestions, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Use history for suggestions" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Use history for suggestions information" AutomationProperties.HelpText="Offers matching saved terms as you type." ToolTipService.ToolTip="Offers matching saved terms as you type." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <NumberBox
                                AutomationProperties.Name="Search history limit"

                                Maximum="{Binding MaximumSearchHistoryLimit}"
                                Minimum="{Binding MinimumSearchHistoryLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SearchHistoryLimit, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Search history limit" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Search history limit information" AutomationProperties.HelpText="Maximum number of saved search terms." ToolTipService.ToolTip="Maximum number of saved search terms." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></NumberBox.Header>
                            </NumberBox>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifAppearanceSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Theme" />

                            <ComboBox
                                AutomationProperties.Name="Application theme"

                                ItemsSource="{Binding Themes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Theme, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Application theme" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Application theme information" AutomationProperties.HelpText="Choose Windows, light, or dark. High contrast follows Windows." ToolTipService.ToolTip="Choose Windows, light, or dark. High contrast follows Windows." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ComboBox.Header>
                            </ComboBox>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource CopyGifSettingsSectionBorderStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource CopyGifSectionTitleTextStyle}" Text="Quality" />
                            <ComboBox AutomationProperties.Name="Copy quality"
                                ItemsSource="{Binding GifQualities}" ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding CopyQuality, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Copy quality" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Copy quality information" AutomationProperties.HelpText="Chooses which GIF the provider supplies for copying to other apps. Minimum is the smallest file and Maximum is the original. The nearest available size is used when a provider omits one." ToolTipService.ToolTip="Chooses which GIF the provider supplies for copying to other apps. Minimum is the smallest file and Maximum is the original. The nearest available size is used when a provider omits one." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ComboBox.Header>
                            </ComboBox>
                            <ComboBox AutomationProperties.Name="Save quality"
                                ItemsSource="{Binding GifQualities}" ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding SaveQuality, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Save quality" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Save quality information" AutomationProperties.HelpText="Chooses which GIF is stored in Favorites and Recents. It applies only to files saved from now on, so files already saved keep the quality they were saved at." ToolTipService.ToolTip="Chooses which GIF is stored in Favorites and Recents. It applies only to files saved from now on, so files already saved keep the quality they were saved at." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ComboBox.Header>
                            </ComboBox>
                            <ComboBox AutomationProperties.Name="Display quality"
                                ItemsSource="{Binding GifQualities}" ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding DisplayQuality, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Display quality" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Display quality information" AutomationProperties.HelpText="Sets how large each thumbnail is decoded inside CopyGIF, from 128 pixels at Minimum to 512 at Maximum. It changes image memory only. What is copied and what is saved are unaffected." ToolTipService.ToolTip="Sets how large each thumbnail is decoded inside CopyGIF, from 128 pixels at Minimum to 512 at Maximum. It changes image memory only. What is copied and what is saved are unaffected." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ComboBox.Header>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifLibrarySettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Saved GIF limits" />

                            <NumberBox
                                AutomationProperties.Name="Recent GIF limit"

                                Maximum="{Binding MaximumRecentLimit}"
                                Minimum="{Binding MinimumRecentLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding RecentLimit, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Recent GIF limit" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Recent GIF limit information" AutomationProperties.HelpText="A new copy removes the oldest Recent when the limit is reached." ToolTipService.ToolTip="A new copy removes the oldest Recent when the limit is reached." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></NumberBox.Header>
                            </NumberBox>

                            <NumberBox
                                AutomationProperties.Name="Favorite GIF limit"

                                Maximum="{Binding MaximumFavoriteLimit}"
                                Minimum="{Binding MinimumFavoriteLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding FavoriteLimit, Mode=TwoWay}">
                                <NumberBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Favorite GIF limit" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Favorite GIF limit information" AutomationProperties.HelpText="Maximum Favorites. Lowering it keeps existing entries." ToolTipService.ToolTip="Maximum Favorites. Lowering it keeps existing entries." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></NumberBox.Header>
                            </NumberBox>

                            <ToggleSwitch
                                AutomationProperties.Name="Store Favorite GIFs locally"

                                IsOn="{Binding StoreFavoritesLocally, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Store Favorites locally" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Store Favorites locally information" AutomationProperties.HelpText="Saves new Favorites as files for either provider." ToolTipService.ToolTip="Saves new Favorites as files for either provider." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <ToggleSwitch
                                AutomationProperties.Name="Store Recent GIFs locally"

                                IsOn="{Binding StoreRecentsLocally, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Store Recents locally" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Store Recents locally information" AutomationProperties.HelpText="Saves new Recents as files. Clipboard files are separate." ToolTipService.ToolTip="Saves new Recents as files. Clipboard files are separate." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Storage location" />
                            <Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Left"
                                AutomationProperties.Name="Storage location information"
                                AutomationProperties.HelpText="Moves saved library files to the selected folder."
                                ToolTipService.ToolTip="Moves saved library files to the selected folder." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button>

                            <TextBlock
                                AutomationProperties.Name="Current library storage location"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding StorageLocationText}" />

                            <StackPanel
                                Orientation="Vertical"
                                Spacing="8">

                                <Button
                                    AutomationProperties.Name="Choose library storage folder"
                                    Command="{Binding ChooseStorageRootCommand}"
                                    Content="Choose folder" />

                                <Button
                                    AutomationProperties.Name="Use default library storage folder"
                                    Command="{Binding ResetStorageRootCommand}"
                                    Content="Use default" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Logs and staged files" />
                            <Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Left"
                                AutomationProperties.Name="Logs and staged files information"
                                AutomationProperties.HelpText="These are the folders this build is really using. A packaged build stores them inside its own package folder, not where the plain AppData path would suggest."
                                ToolTipService.ToolTip="These are the folders this build is really using. A packaged build stores them inside its own package folder, not where the plain AppData path would suggest." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button>

                            <TextBlock
                                AutomationProperties.Name="Current log folder"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding LogsLocationText}" />

                            <TextBlock
                                AutomationProperties.Name="Current clipboard staging folder"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding ClipboardLocationText}" />

                            <StackPanel
                                Orientation="Vertical"
                                Spacing="8">

                                <Button
                                    AutomationProperties.Name="Open log folder"
                                    Command="{Binding OpenLogsFolderCommand}"
                                    Content="Open logs folder" />

                                <Button
                                    AutomationProperties.Name="Open clipboard staging folder"
                                    Command="{Binding OpenClipboardFolderCommand}"
                                    Content="Open clipboard folder" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate x:Key="CopyGifApiSettingsTemplate">
                <StackPanel Spacing="16">
                    <ComboBox Header="GIF provider" ItemsSource="{Binding Providers}"
                        DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ActiveProviderId, Mode=TwoWay}" />
                    <Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Left"
                        AutomationProperties.Name="GIF provider information"
                        AutomationProperties.HelpText="Choose a provider for future searches. Each provider has a separate protected API key."
                        ToolTipService.ToolTip="Choose a provider for future searches. Each provider has a separate protected API key." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button>
                    <Border Style="{StaticResource CopyGifSettingsSectionBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="KLIPY" Style="{StaticResource CopyGifSectionTitleTextStyle}" />
                            <PasswordBox Header="KLIPY API key" Password="{Binding KlipyCredential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PasswordRevealMode="Peek" PlaceholderText="{Binding KlipyPlaceholder}" />
                            <TextBlock Text="A replacement key is checked when you apply changes." TextWrapping="Wrap" />
                            <CheckBox Content="Remove saved KLIPY key on Apply" IsChecked="{Binding DeleteKlipyKey, Mode=TwoWay}" />
                            <HyperlinkButton Content="Open KLIPY API key help" NavigateUri="https://partner.klipy.com/api-keys" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CopyGifSettingsSectionBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="GIPHY" Style="{StaticResource CopyGifSectionTitleTextStyle}" />
                            <PasswordBox Header="GIPHY API key" Password="{Binding GiphyCredential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PasswordRevealMode="Peek" PlaceholderText="{Binding GiphyPlaceholder}" />
                            <TextBlock Text="A replacement key is checked when you apply changes." TextWrapping="Wrap" />
                            <CheckBox Content="Remove saved GIPHY key on Apply" IsChecked="{Binding DeleteGiphyKey, Mode=TwoWay}" />
                            <HyperlinkButton Content="Open GIPHY API key help" NavigateUri="https://developers.giphy.com/dashboard/" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifUpdatesSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Visibility="{Binding Update.IsMsiInstallation, Converter={StaticResource MsiVisibilityConverter}}"
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Update preferences" />

                            <ToggleSwitch
                                AutomationProperties.Name="Check for CopyGIF updates"

                                IsOn="{Binding Settings.CheckForUpdates, Mode=TwoWay}">
                                <ToggleSwitch.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Check automatically for updates" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Check automatically for updates information" AutomationProperties.HelpText="Checks while CopyGIF runs. Check now is always available." ToolTipService.ToolTip="Checks while CopyGIF runs. Check now is always available." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ToggleSwitch.Header>
                            </ToggleSwitch>

                            <ComboBox
                                AutomationProperties.Name="Update check frequency"

                                IsEnabled="{Binding Settings.CheckForUpdates}"
                                ItemsSource="{Binding Settings.CheckFrequencies}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Settings.CheckFrequency, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Check frequency" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Check frequency information" AutomationProperties.HelpText="How often an automatic check becomes due." ToolTipService.ToolTip="How often an automatic check becomes due." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ComboBox.Header>
                            </ComboBox>

                            <ComboBox
                                AutomationProperties.Name="Update installation mode"

                                IsEnabled="{Binding Settings.CheckForUpdates}"
                                ItemsSource="{Binding Settings.Modes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Settings.Mode, Mode=TwoWay}">
                                <ComboBox.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Update mode" /><Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Update mode information" AutomationProperties.HelpText="Choose notifications, download and prompt, or automatic install for supported MSI installations." ToolTipService.ToolTip="Choose notifications, download and prompt, or automatic install for supported MSI installations." ><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" /></Button></StackPanel></ComboBox.Header>
                            </ComboBox>

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Update status" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="Installed version:" />

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="{Binding Update.CurrentVersion}" />

                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="Available version:" />

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="{Binding Update.AvailableVersion}" />

                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding Update.Message.Text}" />

                            <ProgressBar
                                Visibility="{Binding Update.IsMsiInstallation, Converter={StaticResource MsiVisibilityConverter}}"
                                AutomationProperties.Name="Update download progress"
                                Maximum="100"
                                Value="{Binding Update.DownloadPercentage}" />

                            <StackPanel
                                Orientation="Vertical"
                                Spacing="8">

                                <Button
                                    AutomationProperties.Name="Check for updates now"
                                    Command="{Binding Update.CheckCommand}"
                                    Content="Check now" />

                                <Button
                                    AutomationProperties.Name="Download and verify update"
                                    Visibility="{Binding Update.IsMsiInstallation, Converter={StaticResource MsiVisibilityConverter}}"
                                    Command="{Binding Update.PrepareCommand}"
                                    Content="Download" />

                                <Button
                                    AutomationProperties.Name="Install verified update"
                                    Visibility="{Binding Update.IsMsiInstallation, Converter={StaticResource MsiVisibilityConverter}}"
                                    Command="{Binding Update.InstallCommand}"
                                    Content="Install"
                                    Style="{StaticResource CopyGifPrimaryButtonStyle}" />

                            </StackPanel>

                            <HyperlinkButton
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Open update release notes"
                                Content="Release notes"
                                NavigateUri="{Binding Update.ReleaseNotesUri}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Settings.Message.Text}" />

                </StackPanel>

            </DataTemplate>

        </ResourceDictionary>

    </Application.Resources>

</Application>
