<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CopyGIF.App.Views.Pages.SearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CopyGIF.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="{StaticResource CopyGifPagePadding}"
        RowSpacing="0"
        Style="{StaticResource CopyGifPageRootStyle}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            Spacing="8">

            <controls:SearchHeader
                x:Name="PageSearchHeader"
                CancelCommand="{Binding CancelCommand, ElementName=Root}"
                ClearCommand="{Binding ClearQueryCommand, ElementName=Root}"
                DebouncedSearchCommand="{Binding DebouncedSearchCommand, ElementName=Root}"
                IsBusy="{Binding IsBusy, ElementName=Root}"
                Query="{Binding Query, ElementName=Root, Mode=TwoWay}"
                RefreshSuggestionsCommand="{Binding RefreshSuggestionsCommand, ElementName=Root}"
                SearchCommand="{Binding SearchCommand, ElementName=Root}"
                Suggestions="{Binding Suggestions, ElementName=Root}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ProviderAttributionText" Text="{Binding AttributionText}" Style="{StaticResource CopyGifStatusTextStyle}" />
                <Border x:Name="GiphyAttribution" Background="Black" Padding="4" Visibility="Collapsed">
                    <Image Source="ms-appx:///Assets/PoweredByGiphy.png" Width="200" Stretch="Uniform"
                           AutomationProperties.Name="Powered By GIPHY" />
                </Border>
            </StackPanel>

            <controls:StatusBanner
                x:Name="PageStatusBanner"
                IsClosable="False"
                Message="{Binding StatusMessage, ElementName=Root}"
                Severity="{Binding StatusSeverity, ElementName=Root}"
                Title="Search status" />

        </StackPanel>

        <Grid Grid.Row="1">

            <GridView
                Padding="0"
                x:Name="ResultsGridView"
                AutomationProperties.Name="GIF search results"
                IsItemClickEnabled="False"
                IsTabStop="False"
                ItemContainerStyle="{StaticResource CopyGifGridItemStyle}"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ItemTemplate="{Binding ItemTemplate, ElementName=Root}"
                ItemsSource="{Binding ItemsSource, ElementName=Root}"
                SelectionMode="None">

                <GridView.Footer>
        <Button
            x:Name="LoadMoreButton"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            AutomationProperties.Name="Load more GIFs"
            Command="{Binding LoadMoreCommand, ElementName=Root}"
            Content="Load more" />
                </GridView.Footer>

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            Orientation="Horizontal"
                            ItemWidth="204"
                            ItemHeight="236" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

            </GridView>

            <StackPanel
                x:Name="EmptyStatePanel"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Spacing="8">

                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource CopyGifSectionTitleTextStyle}"
                    Text="No GIFs to show" />

                <TextBlock
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                    Text="Enter a search above or choose one of the available suggestions." />

            </StackPanel>

        </Grid>



    </Grid>

</Page>
