<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CopyGIF.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="using:CopyGIF.App.Composition"
    xmlns:services="using:CopyGIF.App.Services"
    xmlns:controls="using:CopyGIF.App.Controls">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/Colors.xaml" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/Themes.xaml" />

                <ResourceDictionary
                    Source="ms-appx:///Resources/ControlStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <composition:BooleanNegationConverter
                x:Key="CopyGifBooleanNegationConverter" />

            <composition:UserMessageSeverityConverter
                x:Key="CopyGifMessageSeverityConverter" />

            <services:SettingChoiceLabelConverter x:Key="SettingChoiceLabelConverter" />
            <DataTemplate x:Key="SettingChoiceTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingChoiceLabelConverter}}" TextWrapping="Wrap" />
            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifGifCardTemplate">

                <controls:GifCard
                    AnimatePreview="{Binding ReducedMotion, Converter={StaticResource CopyGifBooleanNegationConverter}}"
                    AutomationProperties.HelpText="Press Enter to copy this GIF. Use the Favorite button to change its saved state."
                    IsBusy="{Binding IsBusy}"
                    IsFavorite="{Binding IsFavorite}"
                    PreviewUri="{Binding CurrentSource}"
                    LoadThumbnailCommand="{Binding LoadThumbnailCommand}"
                    StartPreviewCommand="{Binding StartPreviewCommand}"
                    StopPreviewCommand="{Binding StopPreviewCommand}"
                    ProviderName="{Binding ProviderId}"
                    SelectCommand="{Binding CopyCommand}"
                    ThumbnailUri="{Binding ThumbnailSource}"
                    Title="{Binding Title}"
                    ToggleFavoriteCommand="{Binding ToggleFavoriteCommand}" />

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifOnboardingTemplate">

                <StackPanel Spacing="16">

                    <ComboBox Header="GIF provider" ItemsSource="{Binding Providers}"
                        DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}" />
                    <TextBlock Text="Choose the provider for GIF search. Finish validates its key and saves this selection." TextWrapping="Wrap" />

                    <TextBlock
                        Style="{StaticResource CopyGifSectionTitleTextStyle}"
                        Text="{Binding ProviderDisplayName}" />

                    <TextBlock
                        Style="{StaticResource CopyGifPageSubtitleTextStyle}"
                        Text="Create an API key for the selected provider, then paste it below. For GIPHY, choose API instead of SDK. Finish encrypts the key on this PC."
                        TextWrapping="Wrap" />

                    <PasswordBox
                        AutomationProperties.Name="GIF provider API key"
                        Header="API key"
                        Password="{Binding Credential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PasswordRevealMode="Peek"
                        PlaceholderText="Enter your API key" />

                    <HyperlinkButton
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Open API key help"
                        Command="{Binding OpenCredentialHelpCommand}"
                        Content="Open provider API keys" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifGeneralSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Activation" />

                            <TextBox
                                AutomationProperties.Name="Global hotkey"
                                Header="Global hotkey"
                                PlaceholderText="Alt+G"
                                Text="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="After Apply, this shortcut opens GIF search from any app. Alt+G is the default; an unavailable shortcut is reported." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Start CopyGIF with Windows"
                                Header="Start with Windows"
                                IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, CopyGIF starts when you sign in to Windows. Windows may require you to enable this in Startup apps." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Window behavior" />

                            <ToggleSwitch
                                AutomationProperties.Name="Hide when CopyGIF loses focus"
                                Header="Hide when CopyGIF loses focus"
                                IsOn="{Binding CloseWhenFocusLost, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately: hides CopyGIF when you switch to another app, while keeping your Settings draft." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Hide CopyGIF after copying a GIF"
                                Header="Hide after copy"
                                IsOn="{Binding HideAfterCopy, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately: hides GIF search after a successful copy so you can paste into your other app." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch Header="Close to system tray"
                                AutomationProperties.Name="Close to system tray" IsOn="{Binding CloseToTray, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately: the main window X keeps CopyGIF running in the tray. Turn off to exit; tray Exit always exits." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />
                            <ToggleSwitch Header="Center window when opened from tray"
                                AutomationProperties.Name="Center window when opened from tray" IsOn="{Binding CenterOnTrayOpen, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately: tray Open centers the window on that screen. Turn off to use normal window placement." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ComboBox
                                AutomationProperties.Name="Window placement mode"
                                Header="Window placement"
                                ItemsSource="{Binding PlacementModes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding PlacementMode, Mode=TwoWay}" />
                            <TextBlock Text="Previews on the next activation. Choose near the mouse, centered on the current screen, or your last position." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Remember window size"
                                Header="Remember window size"
                                IsOn="{Binding RememberWindowSize, Mode=TwoWay}" />
                            <TextBlock Text="Previews on the next activation: restores the width and height you last used." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifSearchSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Results" />

                            <NumberBox
                                AutomationProperties.Name="Results per search"
                                Header="Results per search"
                                Maximum="{Binding MaximumResultsPerSearch}"
                                Minimum="{Binding MinimumResultsPerSearch}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ResultsPerSearch, Mode=TwoWay}" />
                            <TextBlock Text="Previews on the next request: sets the number of GIFs requested per page. GIPHY allows up to 50 per page." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <NumberBox
                                AutomationProperties.Name="Search debounce milliseconds"
                                Header="Search delay after typing (ms)"
                                Maximum="{Binding MaximumDebounceMilliseconds}"
                                Minimum="{Binding MinimumDebounceMilliseconds}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding DebounceMilliseconds, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately: waits this many milliseconds after typing stops before searching. Enter or Search runs immediately." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Animate GIF previews"
                                Header="Animate previews"
                                IsOn="{Binding AnimatePreviews, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately: GIFs animate only while hovered. Windows animation preferences can also disable playback." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Automatically load more GIF results"
                                Header="Automatically load more results"
                                IsOn="{Binding AutoLoadMoreResults, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately: scroll downward again at the bottom to request one more page. Load more remains available." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Show Trending GIFs when search is empty"
                                Header="Show Trending GIFs when search is empty"
                                IsOn="{Binding ShowTrendingWhenEmpty, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately: shows trending GIFs when the search is empty, including after you clear a search." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="History and suggestions" />

                            <ToggleSwitch
                                AutomationProperties.Name="Save search history"
                                Header="Save search history"
                                IsOn="{Binding SaveSearchHistory, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, remembers future search terms on this PC. Turning this off does not delete existing history." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Use search history for suggestions"
                                Header="Use history for suggestions"
                                IsOn="{Binding UseHistorySuggestions, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, offers matching saved search terms as you type." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <NumberBox
                                AutomationProperties.Name="Search history limit"
                                Header="Search history limit"
                                Maximum="{Binding MaximumSearchHistoryLimit}"
                                Minimum="{Binding MinimumSearchHistoryLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SearchHistoryLimit, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, limits the number of search terms retained when history is next updated." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifAppearanceSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Theme" />

                            <ComboBox
                                AutomationProperties.Name="Application theme"
                                Header="Application theme"
                                ItemsSource="{Binding Themes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Theme, Mode=TwoWay}" />
                            <TextBlock Text="Previews immediately in all CopyGIF windows. Follow Windows uses its light or dark theme; high contrast follows Windows." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifLibrarySettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Saved GIF limits" />

                            <NumberBox
                                AutomationProperties.Name="Recent GIF limit"
                                Header="Recent GIF limit"
                                Maximum="{Binding MaximumRecentLimit}"
                                Minimum="{Binding MinimumRecentLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding RecentLimit, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, limits future recent GIF history. New copies may remove the oldest entries at the limit." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <NumberBox
                                AutomationProperties.Name="Favorite GIF limit"
                                Header="Favorite GIF limit"
                                Maximum="{Binding MaximumFavoriteLimit}"
                                Minimum="{Binding MinimumFavoriteLimit}"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding FavoriteLimit, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, sets the maximum number of Favorites. Lowering it does not delete existing Favorites." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Store Favorite GIFs locally"
                                Header="Store Favorites locally"
                                IsOn="{Binding StoreFavoritesLocally, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, new KLIPY Favorites include a local GIF file. Existing saved files are kept." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ToggleSwitch
                                AutomationProperties.Name="Store Recent GIFs locally"
                                Header="Store Recents locally"
                                IsOn="{Binding StoreRecentsLocally, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, new KLIPY Recents include local GIF files. Clipboard files remain independent of Recents." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Storage location" />
                            <TextBlock Text="Choose a folder to stage a new location. Apply moves existing library files; Discard keeps the old location. Use default stages the standard app folder." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <TextBlock
                                AutomationProperties.Name="Current library storage location"
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding StorageLocationText}" />

                            <StackPanel
                                Orientation="Vertical"
                                Spacing="8">

                                <Button
                                    AutomationProperties.Name="Choose library storage folder"
                                    Command="{Binding ChooseStorageRootCommand}"
                                    Content="Choose folder" />

                                <Button
                                    AutomationProperties.Name="Use default library storage folder"
                                    Command="{Binding ResetStorageRootCommand}"
                                    Content="Use default" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Message.Text}" />

                </StackPanel>

            </DataTemplate>

            <DataTemplate x:Key="CopyGifApiSettingsTemplate">
                <StackPanel Spacing="16">
                    <ComboBox Header="GIF provider" ItemsSource="{Binding Providers}"
                        DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ActiveProviderId, Mode=TwoWay}" />
                    <TextBlock Text="After Apply, new searches use this provider. Keys are independent and are encrypted on this PC. Leaving a key blank keeps its saved value." TextWrapping="Wrap" />
                    <Border Style="{StaticResource CopyGifSettingsSectionBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="KLIPY" Style="{StaticResource CopyGifSectionTitleTextStyle}" />
                            <TextBlock Text="{Binding KlipyStatus}" TextWrapping="Wrap" />
                            <PasswordBox Header="KLIPY API key" Password="{Binding KlipyCredential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PasswordRevealMode="Peek" PlaceholderText="Enter a replacement key" />
                            <TextBlock Text="A changed key is checked and encrypted only when you select Apply." TextWrapping="Wrap" />
                            <CheckBox Content="Remove saved KLIPY key on Apply" IsChecked="{Binding DeleteKlipyKey, Mode=TwoWay}" />
                            <TextBlock Text="Removal takes effect on Apply. Uncheck this box or Discard to keep the saved key." TextWrapping="Wrap" />
                            <HyperlinkButton Content="Open KLIPY API key help" NavigateUri="https://partner.klipy.com/api-keys" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CopyGifSettingsSectionBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="GIPHY" Style="{StaticResource CopyGifSectionTitleTextStyle}" />
                            <TextBlock Text="{Binding GiphyStatus}" TextWrapping="Wrap" />
                            <PasswordBox Header="GIPHY API key" Password="{Binding GiphyCredential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PasswordRevealMode="Peek" PlaceholderText="Enter a replacement key" />
                            <TextBlock Text="A changed key is checked and encrypted only when you select Apply." TextWrapping="Wrap" />
                            <CheckBox Content="Remove saved GIPHY key on Apply" IsChecked="{Binding DeleteGiphyKey, Mode=TwoWay}" />
                            <TextBlock Text="Removal takes effect on Apply. Uncheck this box or Discard to keep the saved key." TextWrapping="Wrap" />
                            <HyperlinkButton Content="Open GIPHY API key help" NavigateUri="https://developers.giphy.com/dashboard/" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="For GIPHY, create an API key for the native app. GIPHY results use direct media and are not added to Favorites or Recents; KLIPY library settings continue to apply to KLIPY." TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate
                x:Key="CopyGifUpdatesSettingsTemplate">

                <StackPanel Spacing="16">

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Update preferences" />

                            <ToggleSwitch
                                AutomationProperties.Name="Check for CopyGIF updates"
                                Header="Check automatically for updates"
                                IsOn="{Binding Settings.CheckForUpdates, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, checks for updates while CopyGIF runs, including in the tray. Check now remains available." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ComboBox
                                AutomationProperties.Name="Update check frequency"
                                Header="Check frequency"
                                IsEnabled="{Binding Settings.CheckForUpdates}"
                                ItemsSource="{Binding Settings.CheckFrequencies}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Settings.CheckFrequency, Mode=TwoWay}" />
                            <TextBlock Text="After Apply, checks when this interval has elapsed since the last successful check." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                            <ComboBox
                                AutomationProperties.Name="Update installation mode"
                                Header="Update mode"
                                IsEnabled="{Binding Settings.CheckForUpdates}"
                                ItemsSource="{Binding Settings.Modes}"
                                ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                SelectedItem="{Binding Settings.Mode, Mode=TwoWay}" />
                            <TextBlock Text="Recommended installs verified per-user MSI updates automatically and asks before other MSI installs. Store updates follow Microsoft Store." TextWrapping="Wrap" Style="{StaticResource CopyGifPageSubtitleTextStyle}" />

                        </StackPanel>

                    </Border>

                    <Border
                        Style="{StaticResource CopyGifSettingsSectionBorderStyle}">

                        <StackPanel Spacing="16">

                            <TextBlock
                                Style="{StaticResource CopyGifSectionTitleTextStyle}"
                                Text="Update status" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="Installed version:" />

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="{Binding Update.CurrentVersion}" />

                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="Available version:" />

                                <TextBlock
                                    Style="{StaticResource CopyGifStatusTextStyle}"
                                    Text="{Binding Update.AvailableVersion}" />

                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource CopyGifStatusTextStyle}"
                                Text="{Binding Update.Message.Text}" />

                            <ProgressBar
                                AutomationProperties.Name="Update download progress"
                                Maximum="100"
                                Value="{Binding Update.DownloadPercentage}" />

                            <StackPanel
                                Orientation="Vertical"
                                Spacing="8">

                                <Button
                                    AutomationProperties.Name="Check for updates now"
                                    Command="{Binding Update.CheckCommand}"
                                    Content="Check now" />

                                <Button
                                    AutomationProperties.Name="Download and verify update"
                                    Command="{Binding Update.PrepareCommand}"
                                    Content="Download" />

                                <Button
                                    AutomationProperties.Name="Install verified update"
                                    Command="{Binding Update.InstallCommand}"
                                    Content="Install"
                                    Style="{StaticResource CopyGifPrimaryButtonStyle}" />

                            </StackPanel>

                            <HyperlinkButton
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Open update release notes"
                                Content="Release notes"
                                NavigateUri="{Binding Update.ReleaseNotesUri}" />

                        </StackPanel>

                    </Border>

                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CopyGifStatusTextStyle}"
                        Text="{Binding Settings.Message.Text}" />

                </StackPanel>

            </DataTemplate>

        </ResourceDictionary>

    </Application.Resources>

</Application>
